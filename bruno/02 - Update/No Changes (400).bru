meta {
  name: No Changes (400)
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/v1/document/{{documentId}}
  body: multipartForm
  auth: inherit
}

body:multipart-form {
  metadata: @file(../payloads/update-empty.json)
}

settings {
  encodeUrl: true
  timeout: 0
}

tests {
  test("rejects an update with nothing to change", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.body.detail).to.equal("Update request must include metadata, documentType, or a file");
  });
}

docs {
  `update-empty.json` is `{}` - a `DocumentUpdateRequest` with no `metadata`, no
  `documentType`, and no `file` part is a no-op the controller rejects outright before
  calling the service layer.
}
