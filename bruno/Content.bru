}

get {
  url: http://localhost:8081/document/content/:id
  body: none
  auth: inherit
}

params:path {
  id: f102f673-dc48-46d7-9f50-a2526bf80992
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Returns a presigned download URL for the latest content by default. Append a version
  number for a specific past version's file instead, e.g. `/document/content/:id/1` -
  404s if that version never had a file uploaded (e.g. a metadata-only update).
}
