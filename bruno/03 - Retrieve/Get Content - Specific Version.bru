meta {
  name: Get Content - Specific Version
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/v1/document/content/{{documentId}}/1
  body: none
  auth: inherit
}

settings {
  encodeUrl: true
  timeout: 0
}

tests {
  test("returns a presigned download url for version 1's original file", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.body.url).to.include("/1/");
  });
}

docs {
  The MinIO key is `{{documentId}}/1/{name}` - note the version segment in the URL path,
  distinct from whatever the current/latest version's key looks like.
}
