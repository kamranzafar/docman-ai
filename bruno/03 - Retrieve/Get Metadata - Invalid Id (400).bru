meta {
  name: Get Metadata - Invalid Id (400)
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/document/metadata/not-a-uuid
  body: none
  auth: inherit
}

settings {
  encodeUrl: true
  timeout: 0
}

tests {
  test("rejects a non-UUID id", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.body.detail).to.equal("Invalid document id: not-a-uuid");
  });
}

docs {
  `parseId()` in `DocumentController` rejects anything `UUID.fromString` can't parse,
  before any repository lookup happens.
}
