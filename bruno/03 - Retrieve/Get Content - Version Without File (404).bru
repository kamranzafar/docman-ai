meta {
  name: Get Content - Version Without File (404)
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/v1/document/content/{{documentId}}/2
  body: none
  auth: inherit
}

settings {
  encodeUrl: true
  timeout: 0
}

tests {
  test("returns 404 when a version has no file of its own", function () {
    expect(res.getStatus()).to.equal(404);
    expect(res.body.detail).to.equal("Document content not found for version 2");
  });
}

docs {
  Version 2 (from "Metadata Only (PUT)" in `02 - Update`) is a metadata-only revision - no
  object was ever written to `{{documentId}}/2/...` in MinIO, so
  `objectStoreService.documentExists()` returns false and the controller 404s explicitly
  rather than handing back a presigned URL that would 403 on download.
}
