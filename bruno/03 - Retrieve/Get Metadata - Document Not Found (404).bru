meta {
  name: Get Metadata - Document Not Found (404)
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/document/metadata/00000000-0000-0000-0000-000000000000
  body: none
  auth: inherit
}

settings {
  encodeUrl: true
  timeout: 0
}

tests {
  test("returns 404 for a well-formed but nonexistent document id", function () {
    expect(res.getStatus()).to.equal(404);
    expect(res.body.detail).to.equal("Document not found");
  });
}

docs {
  Valid UUID, no matching document.
}
