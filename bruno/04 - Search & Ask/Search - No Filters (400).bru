meta {
  name: Search - No Filters (400)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/document/search
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {}
}

settings {
  encodeUrl: true
  timeout: 0
}

tests {
  test("requires at least one filter", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.body.detail).to.equal("At least one metadata filter is mandatory");
  });
}

docs {
  Unfiltered lexical search isn't supported - `filters` must be non-empty.
}
