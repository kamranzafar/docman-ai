meta {
  name: Delete - Not Found (404)
  type: http
  seq: 2
}

delete {
  url: {{baseUrl}}/api/v1/document/00000000-0000-0000-0000-000000000000
  body: none
  auth: inherit
}

settings {
  encodeUrl: true
  timeout: 0
}

tests {
  test("returns 404 for a well-formed but nonexistent document id", function () {
    expect(res.getStatus()).to.equal(404);
    expect(res.body.detail).to.equal("Document not found");
  });
}

docs {
  Delete looks up the document first (to get its current version for workflow
  termination), so a missing document 404s before any cleanup is attempted.
}
