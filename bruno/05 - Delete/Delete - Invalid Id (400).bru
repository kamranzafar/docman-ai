meta {
  name: Delete - Invalid Id (400)
  type: http
  seq: 3
}

delete {
  url: {{baseUrl}}/api/v1/document/not-a-uuid
  body: none
  auth: inherit
}

settings {
  encodeUrl: true
  timeout: 0
}

tests {
  test("rejects a non-UUID id", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.body.detail).to.equal("Invalid document id: not-a-uuid");
  });
}

docs {
  Same `parseId()` validation as every other `{id}` path variable in the controller.
}
