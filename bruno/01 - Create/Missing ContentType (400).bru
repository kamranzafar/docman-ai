meta {
  name: Missing ContentType (400)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/document
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "invoice-123.pdf",
    "metadata": { "vendor": "acme" }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

tests {
  test("returns 400 for missing contentType", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.body.detail).to.equal("Invalid request content.");
  });
}

docs {
  `contentType` is also `@NotBlank` on `DocumentRequest` - omitting it fails the same way
  as omitting `name` (generic "Invalid request content." detail from Spring's default bean
  validation handling).
}
